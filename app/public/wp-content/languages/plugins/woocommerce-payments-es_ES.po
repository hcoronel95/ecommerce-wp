#: includes/multi-currency/CurrencySwitcherBlock.php:143
#: includes/multi-currency/CurrencySwitcherWidget.php:109
#: dist/multi-currency-switcher-block.js:1
msgid "Select your currency"
msgstr "Selecciona tu moneda"

#: includes/fraud-prevention/class-order-fraud-and-risk-meta-box.php:341
msgid "Refund this payment"
msgstr "Reembolsar este pago"

#. translators: %s is the card network's reported fraud reason, e.g. "Made with
#. stolen card"
#: includes/fraud-prevention/class-order-fraud-and-risk-meta-box.php:327
#: dist/chunks/wcpay-money-movement.js:1
msgid "Reported reason: %s"
msgstr "Motivo reportado: %s"

#: includes/fraud-prevention/class-order-fraud-and-risk-meta-box.php:319
msgid "This payment was refunded or disputed, so the warning is no longer actionable."
msgstr "Este pago fue reembolsado o disputado, por lo que la advertencia ya no es accionable."

#: includes/fraud-prevention/class-order-fraud-and-risk-meta-box.php:318
msgid "The card issuer flagged this payment as likely fraudulent. Refunding it now can prevent a dispute."
msgstr "El emisor de la tarjeta marcó este pago como probablemente fraudulento. Reembolsarlo ahora puede prevenir una controversia."

#: includes/fraud-prevention/class-order-fraud-and-risk-meta-box.php:315
#: dist/chunks/wcpay-money-movement.js:1
msgid "Early fraud warning resolved"
msgstr "Alerta temprana de fraude resuelta"

#: includes/fraud-prevention/class-order-fraud-and-risk-meta-box.php:314
#: dist/chunks/wcpay-money-movement.js:1
msgid "Early fraud warning"
msgstr "Alerta temprana de fraude"

#: includes/fraud-prevention/class-order-fraud-and-risk-meta-box.php:243
msgid "Triggered risk filters:"
msgstr "Filtros de riesgo activados:"

#: includes/class-wc-payments-utils.php:1339
#: dist/chunks/wcpay-money-movement.js:1
msgid "Unauthorized use of card"
msgstr "Uso no autorizado de la tarjeta"

#: includes/class-wc-payments-utils.php:1335
#: dist/chunks/wcpay-money-movement.js:1
msgid "Made with stolen card"
msgstr "Realizado con tarjeta robada"

#: includes/class-wc-payments-utils.php:1333
#: dist/chunks/wcpay-money-movement.js:1
msgid "Made with lost card"
msgstr "Realizado con tarjeta perdida"

#: includes/class-wc-payments-utils.php:1331
#: dist/chunks/wcpay-money-movement.js:1
msgid "Made with counterfeit card"
msgstr "Realizado con tarjeta falsificada"

#: includes/class-wc-payments-utils.php:1329
#: dist/chunks/wcpay-money-movement.js:1
msgid "Fraudulent card application"
msgstr "Solicitud de tarjeta fraudulenta"

#: includes/class-wc-payments-utils.php:1327
#: dist/chunks/wcpay-money-movement.js:1
msgid "Card never received"
msgstr "Tarjeta nunca recibida"

#. translators: %1: the early fraud warning reason, e.g. "Made with stolen
#. card"
#: includes/class-wc-payments-order-service.php:2606
msgid "Payment has received an early fraud warning with reason \"%1$s\". <refund>Refunding the payment now</refund> can prevent a dispute. See <a>payment details</a> for more information."
msgstr "El pago ha recibido una alerta temprana de fraude con el motivo «%1$s». <refund>Reembolsar el pago ahora</refund> puede prevenir una controversia. Consulta los <a>detalles del pago</a> para más información."

#: includes/class-wc-payments-order-service.php:2593
msgid "Payment has received an early fraud warning. <refund>Refunding the payment now</refund> can prevent a dispute. See <a>payment details</a> for more information."
msgstr "El pago ha recibido una alerta temprana de fraude. <refund>Reembolsar el pago ahora</refund> puede prevenir una controversia. Consulta los <a>detalles del pago</a> para más información."

#: includes/class-wc-payments-order-service.php:2575
msgid "The early fraud warning received for this payment is no longer actionable, because the payment was refunded or disputed. See <a>payment details</a> for more information."
msgstr "La alerta temprana de fraude recibida para este pago ya no es accionable, porque el pago fue reembolsado o disputado. Consulta los <a>detalles del pago</a> para más información."

#. translators: %1: the blocked amount, %2: the list of risk filters that
#. blocked the payment
#: includes/class-wc-payments-order-service.php:2389
msgid "&#x1F6AB; A payment of %1$s was <strong>blocked</strong> by the following risk filters:<br>%2$s<br><br><a>View more details</a>."
msgstr "&#x1F6AB; Un pago de %1$s fue <strong>bloqueado</strong> por los siguientes filtros de riesgo:<br>%2$s<br><br><a>Ver más detalles</a>."

#. translators: %1: the amount held for review, %2: the list of risk filters
#. that held the payment for review
#: includes/class-wc-payments-order-service.php:2357
msgid "&#x26D4; A payment of %1$s was <strong>held for review</strong> by the following risk filters:<br>%2$s<br><br><a>View more details</a>."
msgstr "&#x26D4; Un pago de %1$s fue <strong>retenido para revisión</strong> por los siguientes filtros de riesgo:<br>%2$s<br><br><a>Ver más detalles</a>."

#: includes/class-wc-payments-order-service.php:687
msgid "The order was not marked as completed because it has already been fully refunded."
msgstr "El pedido no se marcó como completado porque ya ha sido reembolsado por completo."

#: includes/class-duplicate-payment-prevention-service.php:272
msgid "WooPayments: detected and prevented a second payment for this order, which had already been paid."
msgstr "WooPayments: se detectó y previno un segundo pago para este pedido, que ya había sido pagado."

#. translators: %d: the number of disputes on this payment that are still open
#: includes/class-wc-payments-order-service.php:669
msgid "The order was not marked as completed because %d other dispute on this payment is still open."
msgid_plural "The order was not marked as completed because %d other disputes on this payment are still open."
msgstr[0] "El pedido no se marcó como completado porque hay %d disputa más sobre este pago que sigue abierta."
msgstr[1] "El pedido no se marcó como completado porque hay %d disputa más sobre este pago que siguen abiertas."

#: includes/compat/subscriptions/trait-wc-payment-gateway-wcpay-subscriptions.php:536
msgid "Recovered missing subscription payment method token from the parent order."
msgstr "Se recuperó el token del método de pago de la suscripción que faltaba del pedido padre."

#. translators: %s: the recovered payment method, e.g. "Visa ending in 4242
#. (expires 01/26)"
#: includes/compat/subscriptions/trait-wc-payment-gateway-wcpay-subscriptions.php:530
msgid "The saved payment method for this subscription was missing, so WooPayments restored %s from the original order to complete the renewal."
msgstr "El método de pago guardado para esta suscripción no estaba disponible, por lo que WooPayments ha restaurado %s del pedido original para completar la renovación."

#. translators: 1: Previous payment token ID, 2: New payment token ID.
#: includes/class-wc-payments-webhook-processing-service.php:669
msgid "WooPayments updated the subscription payment method token from token #%1$d to #%2$d after receiving a successful renewal payment webhook."
msgstr "WooPayments actualizó el token del método de pago de la suscripción del token #%1$d al #%2$d después de recibir un webhook de pago de renovación exitoso."

#. translators: %s: the dispute ID
#: includes/class-wc-payments-order-service.php:2498
#: includes/class-wc-payments-order-service.php:2552
#: includes/class-wc-payments-webhook-processing-service.php:842
msgid "(Dispute ID: %s)"
msgstr "(ID de disputa: %s)"

#: includes/class-wc-payment-gateway-wcpay.php:2853
msgid "Unable to save payment method for subscription. The order customer could not be found."
msgstr "No se ha podido guardar el método de pago para la suscripción. No se ha encontrado al cliente del pedido."

#: src/Internal/Service/DisputeReadinessService.php:266
msgid "Give customers a direct way to reach you from their order emails to handle issues quickly."
msgstr "Ofrece a los clientes una forma directa de contactarte desde sus correos de pedido para resolver problemas rápidamente."

#: src/Internal/Service/DisputeReadinessService.php:265
msgid "Customer support contact linked in order emails"
msgstr "Contacto de soporte al cliente enlazado en los correos de pedido"

#: src/Internal/Service/DisputeReadinessService.php:237
msgid "Make sure your business name appears clearly on customer bank statements to prevent confusion."
msgstr "Asegúrate de que el nombre de tu negocio aparezca claramente en los extractos bancarios de los clientes para evitar confusiones."

#: src/Internal/Service/DisputeReadinessService.php:236
msgid "Recognizable statement descriptor"
msgstr "Descripción del extracto reconocible"

#: src/Internal/Service/DisputeReadinessService.php:228
msgid "Looks good"
msgstr "Tiene buena pinta"

#: src/Internal/Service/DisputeReadinessService.php:226
msgid "Your statement descriptor will show up on your customers' bank statements. Does it clearly identify your store?"
msgstr "La descripción de tu extracto aparecerá en los extractos bancarios de tus clientes. ¿Identifica claramente tu tienda?"

#: src/Internal/Service/DisputeReadinessService.php:201
msgid "Add a T&C link at checkout so customers acknowledge your policies before completing a purchase."
msgstr "Añade un enlace a TyC en el pago para que los clientes acepten tus políticas antes de completar una compra."

#: src/Internal/Service/DisputeReadinessService.php:200
msgid "Terms & conditions linked at checkout"
msgstr "Términos y condiciones enlazados en el pago"

#: src/Internal/Service/DisputeReadinessService.php:183
#: src/Internal/Service/DisputeReadinessService.php:202
#: src/Internal/Service/DisputeReadinessService.php:220
#: src/Internal/Service/DisputeReadinessService.php:267
#: dist/chunks/wcpay-overview.js:1
msgid "Fix it"
msgstr "Solucionarlo"

#: src/Internal/Service/DisputeReadinessService.php:182
msgid "Publish a refund policy so customers can resolve issues with you before filing a dispute."
msgstr "Publica una política de reembolso para que los clientes puedan resolver problemas contigo antes de presentar una controversia."

#: src/Internal/Service/DisputeReadinessService.php:181
msgid "Refund policy page published"
msgstr "Página de política de reembolso publicada"

#. translators: %d: maximum file size in bytes.
#: src/Internal/Abilities/Domain/UploadDisputeEvidenceFile.php:153
msgid "The file exceeds the %d-byte dispute-evidence size limit."
msgstr "El archivo supera el límite de tamaño de %d bytes para pruebas de controversias."

#: src/Internal/Abilities/Domain/UploadDisputeEvidenceFile.php:144
msgid "file_contents must be base64-encoded."
msgstr "file_contents debe estar codificado en base64."

#: src/Internal/Abilities/Domain/UploadDisputeEvidenceFile.php:133
msgid "file_type must be one of application/pdf, image/jpeg, or image/png."
msgstr "file_type debe ser uno de los siguientes: application/pdf, image/jpeg o image/png."

#: src/Internal/Abilities/Domain/UploadDisputeEvidenceFile.php:126
msgid "file_name, file_type, and file_contents are all required to upload a file."
msgstr "file_name, file_type y file_contents son obligatorios para subir un archivo."

#: src/Internal/Abilities/Domain/UploadDisputeEvidenceFile.php:87
msgid "Base64-encoded file contents. The decoded size must not exceed the dispute-evidence size limit."
msgstr "Contenido del archivo codificado en base64. El tamaño decodificado no debe superar el límite de tamaño para pruebas de controversias."

#: src/Internal/Abilities/Domain/UploadDisputeEvidenceFile.php:83
msgid "File MIME type. One of application/pdf, image/jpeg, or image/png."
msgstr "Tipo MIME del archivo. Uno de: application/pdf, image/jpeg o image/png."

#: src/Internal/Abilities/Domain/UploadDisputeEvidenceFile.php:78
msgid "File name including extension (e.g. receipt.pdf)."
msgstr "Nombre del archivo incluyendo la extensión (p. ej., recibo.pdf)."

#: src/Internal/Abilities/Domain/UploadDisputeEvidenceFile.php:70
msgid "Upload a document (PDF, PNG, or JPEG) to use as dispute evidence. Returns a file object whose id can be passed to the document fields of woocommerce-payments/submit-dispute-evidence."
msgstr "Sube un documento (PDF, PNG o JPEG) para usarlo como prueba en una controversia. Devuelve un objeto de archivo cuyo ID se puede pasar a los campos de documento de woocommerce-payments/submit-dispute-evidence."

#: src/Internal/Abilities/Domain/UploadDisputeEvidenceFile.php:69
msgid "Upload dispute evidence file"
msgstr "Subir archivo de pruebas para controversias"

#: src/Internal/Abilities/Domain/SubmitDisputeEvidence.php:168
msgid "Metadata values must be strings of 500 characters or fewer."
msgstr "Los valores de metadatos deben ser cadenas de 500 caracteres o menos."

#: src/Internal/Abilities/Domain/SubmitDisputeEvidence.php:165
msgid "Metadata keys must be strings of 40 characters or fewer."
msgstr "Las claves de metadatos deben ser cadenas de 40 caracteres o menos."

#: src/Internal/Abilities/Domain/SubmitDisputeEvidence.php:160
msgid "Metadata may not contain more than 10 keys."
msgstr "Los metadatos no pueden contener más de 10 claves."

#: src/Internal/Abilities/Domain/SubmitDisputeEvidence.php:150
msgid "A dispute_id is required to submit evidence."
msgstr "Se requiere un dispute_id para enviar pruebas."

#: src/Internal/Abilities/Domain/SubmitDisputeEvidence.php:117
msgid "Optional metadata to attach to the dispute. Maximum 10 keys; keys up to 40 characters; values up to 500 characters."
msgstr "Metadatos opcionales para adjuntar a la controversia. Máximo 10 claves; claves de hasta 40 caracteres; valores de hasta 500 caracteres."

#: src/Internal/Abilities/Domain/SubmitDisputeEvidence.php:113
msgid "Whether to submit to the card network (irreversible). Default false stages a draft."
msgstr "Si se debe enviar a la red de tarjetas (irreversible). El valor predeterminado false lo guarda como borrador."

#: src/Internal/Abilities/Domain/SubmitDisputeEvidence.php:106
msgid "Evidence fields. Text fields take free text; document fields take the ID of a file uploaded via woocommerce-payments/upload-dispute-evidence-file (not raw file contents)."
msgstr "Campos de pruebas. Los campos de texto aceptan texto libre; los campos de documento aceptan el ID de un archivo subido mediante woocommerce-payments/upload-dispute-evidence-file (no el contenido del archivo en bruto)."

#: src/Internal/Abilities/Domain/SubmitDisputeEvidence.php:94
msgid "Stage or submit evidence for a dispute. With submit=false (default) the evidence is saved as a draft you can revise; with submit=true it is sent to the card network and cannot be changed."
msgstr "Prepara o envía pruebas para una controversia. Con submit=false (predeterminado) las pruebas se guardan como borrador para que puedas revisarlas; con submit=true se envían a la red de tarjetas y no se pueden modificar."

#: src/Internal/Abilities/Domain/SubmitDisputeEvidence.php:93
msgid "Submit dispute evidence"
msgstr "Enviar pruebas para controversias"

#. translators: %s: description of what the document should show.
#: src/Internal/Abilities/Domain/SubmitDisputeEvidence.php:86
msgid "%s Provide the ID of a file uploaded via woocommerce-payments/upload-dispute-evidence-file, not raw file contents."
msgstr "%s Proporciona el ID de un archivo subido mediante woocommerce-payments/upload-dispute-evidence-file, no el contenido del archivo en bruto."

#: src/Internal/Abilities/Domain/SubmitDisputeEvidence.php:71
msgid "Any additional supporting document."
msgstr "Cualquier documento de respaldo adicional."

#: src/Internal/Abilities/Domain/SubmitDisputeEvidence.php:70
msgid "Your cancellation policy as shown to the customer."
msgstr "Tu política de cancelación tal como se mostró al cliente."

#: src/Internal/Abilities/Domain/SubmitDisputeEvidence.php:69
msgid "Proof the service was provided to the customer."
msgstr "Prueba de que se prestó el servicio al cliente."

#: src/Internal/Abilities/Domain/SubmitDisputeEvidence.php:68
msgid "Proof the product was delivered (e.g. signed delivery confirmation)."
msgstr "Prueba de que se entregó el producto (p. ej., confirmación de entrega firmada)."

#: src/Internal/Abilities/Domain/SubmitDisputeEvidence.php:67
msgid "Documentation for the prior charge a duplicate dispute refers to."
msgstr "Documentación del cargo anterior al que se refiere una controversia por duplicidad."

#: src/Internal/Abilities/Domain/SubmitDisputeEvidence.php:66
msgid "Your refund policy as shown to the customer."
msgstr "Tu política de reembolso tal como se mostró al cliente."

#: src/Internal/Abilities/Domain/SubmitDisputeEvidence.php:65
msgid "Receipt or message sent to the customer for the charge."
msgstr "Recibo o mensaje enviado al cliente por el cargo."

#: src/Internal/Abilities/Domain/SubmitDisputeEvidence.php:64
msgid "Proof the customer signed for the product or agreed to terms."
msgstr "Prueba de que el cliente firmó la recepción del producto o aceptó los términos."

#: src/Internal/Abilities/Domain/SubmitDisputeEvidence.php:63
msgid "Correspondence with the customer relevant to the dispute (e.g. emails)."
msgstr "Correspondencia con el cliente relevante para la controversia (p. ej., correos)."

#: src/Internal/Abilities/Domain/SubmitDisputeEvidence.php:57
msgid "Address the product was shipped to."
msgstr "Dirección a la que se envió el producto."

#: src/Internal/Abilities/Domain/SubmitDisputeEvidence.php:56
msgid "Tracking number for a shipped physical product."
msgstr "Número de seguimiento de un producto físico enviado."

#: src/Internal/Abilities/Domain/SubmitDisputeEvidence.php:55
msgid "Date the product was shipped."
msgstr "Fecha en que se envió el producto."

#: src/Internal/Abilities/Domain/SubmitDisputeEvidence.php:54
msgid "Delivery service that shipped the product (e.g. USPS, FedEx, UPS, DHL)."
msgstr "Servicio de mensajería que envió el producto (p. ej., USPS, FedEx, UPS, DHL)."

#: src/Internal/Abilities/Domain/SubmitDisputeEvidence.php:53
msgid "Any additional explanation that does not fit another field."
msgstr "Cualquier explicación adicional que no encaje en otro campo."

#: src/Internal/Abilities/Domain/SubmitDisputeEvidence.php:52
msgid "Activity log showing the customer accessed or downloaded a digital product."
msgstr "Registro de actividad que muestra que el cliente accedió o descargó un producto digital."

#: src/Internal/Abilities/Domain/SubmitDisputeEvidence.php:51
msgid "Explanation of why the customer was not entitled to cancel."
msgstr "Explicación de por qué el cliente no tenía derecho a cancelar."

#: src/Internal/Abilities/Domain/SubmitDisputeEvidence.php:50
msgid "IP address the customer used for the purchase."
msgstr "Dirección IP que el cliente usó para la compra."

#: src/Internal/Abilities/Domain/SubmitDisputeEvidence.php:49
msgid "Description of the product or service and how it was presented to the customer."
msgstr "Descripción del producto o servicio y cómo se presentó al cliente."

#: src/Internal/Abilities/Domain/RefundCharge.php:109
msgid "An idempotency_key is required so refund retries are safe."
msgstr "Se requiere un idempotency_key para que los reintentos de reembolso sean seguros."

#: src/Internal/Abilities/Domain/RefundCharge.php:102
msgid "A charge_id is required to create a refund."
msgstr "Se requiere un charge_id para crear un reembolso."

#: src/Internal/Abilities/Domain/RefundCharge.php:71
msgid "Required. A stable, caller-unique key so duplicate retries dedupe to the original refund instead of creating a second one. Reuse the exact same key when retrying the same logical refund."
msgstr "Obligatorio. Una clave estable y única para el llamante para que los reintentos duplicados se dedupliquen al reembolso original en lugar de crear uno nuevo. Reutiliza exactamente la misma clave al reintentar el mismo reembolso lógico."

#: src/Internal/Abilities/Domain/RefundCharge.php:67
msgid "Optional refund reason."
msgstr "Motivo del reembolso (opcional)."

#: src/Internal/Abilities/Domain/RefundCharge.php:62
msgid "Amount to refund in minor units (e.g. cents). Omit for a full refund."
msgstr "Importe a reembolsar en unidades menores (p. ej., céntimos). Omítelo para un reembolso completo."

#: src/Internal/Abilities/Domain/RefundCharge.php:57
msgid "Stripe charge ID to refund (ch_… or py_…)."
msgstr "ID del cargo de Stripe para reembolsar (ch_… o py_…)."

#: src/Internal/Abilities/Domain/RefundCharge.php:48
msgid "Create a full or partial refund on a Stripe charge. Supply a stable idempotency_key to make retries safe — identical keys return the original refund. Amount is in minor units (e.g. cents)."
msgstr "Crea un reembolso total o parcial de un cargo de Stripe. Proporciona un idempotency_key estable para hacer seguros los reintentos: claves idénticas devuelven el reembolso original. El importe está en unidades menores (p. ej., céntimos)."

#: src/Internal/Abilities/Domain/RefundCharge.php:47
msgid "Refund a charge"
msgstr "Reembolsar un cargo"

#: src/Internal/Abilities/Domain/GetTransactionsSummary.php:43
msgid "Return aggregate counts and totals for a transactions filter. Answers 'how many transactions / how much volume in this window?' without paging the list."
msgstr "Devuelve recuentos agregados y totales para un filtro de transacciones. Responde a «¿cuántas transacciones / cuánto volumen en este período?» sin paginar la lista."

#: src/Internal/Abilities/Domain/GetTransactionsSummary.php:42
msgid "Get transactions summary"
msgstr "Obtener resumen de transacciones"

#: src/Internal/Abilities/Domain/GetTransactions.php:90
msgid "List WooPayments transactions with filters (date range, type, source device, channel, customer country, risk level, currency, search). Answers 'show me transactions where X'."
msgstr "Lista las transacciones de WooPayments con filtros (rango de fechas, tipo, dispositivo de origen, canal, país del cliente, nivel de riesgo, moneda, búsqueda). Responde a «muéstrame transacciones donde X»."

#: src/Internal/Abilities/Domain/GetTransactions.php:89
msgid "List transactions"
msgstr "Listar transacciones"

#: src/Internal/Abilities/Domain/GetTimeline.php:87
msgid "A non-empty `intention_id` is required."
msgstr "Se requiere un `intention_id` no vacío."

#: src/Internal/Abilities/Domain/GetTimeline.php:45
msgid "Return the chronological event timeline for a payment intent (created → succeeded → refunded → disputed). Helps reconstruct what happened to one transaction. Takes `intention_id` (the same Stripe `pi_…` identifier accepted by `get-payment-intent` as `payment_intent_id` — both names exist because they mirror the underlying REST route parameters)."
msgstr "Devuelve la línea temporal de eventos cronológicos para una intención de pago (creada → exitosa → reembolsada → en controversia). Ayuda a reconstruir lo que ocurrió con una transacción. Toma `intention_id` (el mismo identificador `pi_…` de Stripe que acepta `get-payment-intent` como `payment_intent_id`; ambos nombres existen porque reflejan los parámetros de la ruta REST subyacente)."

#: src/Internal/Abilities/Domain/GetTimeline.php:44
msgid "Get timeline for payment intent"
msgstr "Obtener línea temporal para intención de pago"

#: src/Internal/Abilities/Domain/GetPaymentIntent.php:91
msgid "A non-empty `payment_intent_id` is required."
msgstr "Se requiere un `payment_intent_id` no vacío."

#: src/Internal/Abilities/Domain/GetPaymentIntent.php:49
msgid "Look up a single payment intent by Stripe ID (pi_…). Answers 'what is the state of intent pi_X?' during incident response."
msgstr "Busca una intención de pago única por ID de Stripe (pi_…). Responde a «¿cuál es el estado de la intención pi_X?» durante la respuesta a incidentes."

#: src/Internal/Abilities/Domain/GetPaymentIntent.php:48
msgid "Get payment intent by ID"
msgstr "Obtener intención de pago por ID"

#: src/Internal/Abilities/Domain/GetFraudOutcomes.php:109
msgid "A status is required to list fraud outcomes."
msgstr "Se requiere un status para listar los resultados de fraude."

#: src/Internal/Abilities/Domain/GetFraudOutcomes.php:64
msgid "List transactions flagged by fraud protection for a given outcome status (e.g. block, review)."
msgstr "Lista las transacciones marcadas por la protección contra fraudes para un estado de resultado determinado (p. ej., block, review)."

#: src/Internal/Abilities/Domain/GetFraudOutcomes.php:63
msgid "List flagged (fraud outcome) transactions"
msgstr "Listar transacciones marcadas (resultado de fraude)"

#: src/Internal/Abilities/Domain/GetFraudOutcomes.php:48
msgid "Fraud outcome status to filter by (e.g. block, review)."
msgstr "Estado del resultado de fraude por el que filtrar (p. ej., block, review)."

#: src/Internal/Abilities/Domain/GetFeesSummary.php:44
msgid "Return aggregate processing-fee totals (count, fees, net) over a date range. Answers 'how much did I pay in fees this period?'."
msgstr "Devuelve los totales agregados de comisiones de procesamiento (recuento, comisiones, neto) en un rango de fechas. Responde a «¿cuánto pagué en comisiones este período?»."

#: src/Internal/Abilities/Domain/GetFeesSummary.php:43
msgid "Get processing-fee summary"
msgstr "Obtener resumen de comisiones de procesamiento"

#: src/Internal/Abilities/Domain/GetDisputesSummary.php:42
msgid "Return aggregate counts of disputes by status. Answers 'how many disputes are pending response right now?'."
msgstr "Devuelve recuentos agregados de controversias por estado. Responde a «¿cuántas controversias están pendientes de respuesta ahora mismo?»."

#: src/Internal/Abilities/Domain/GetDisputesSummary.php:41
msgid "Get disputes summary"
msgstr "Obtener resumen de controversias"

#: src/Internal/Abilities/Domain/GetDisputes.php:72
msgid "List disputes with status and date-range filters. Answers 'which disputes need response?'."
